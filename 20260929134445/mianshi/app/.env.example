# 复制本文件为 .env 并填写真实值（.env 已在 .gitignore 中，不会被提交）

# DeepSeek API Key（必填，否则 AI 功能不可用，刷题不受影响）
DEEPSEEK_API_KEY=

# 模型名：deepseek-chat 或 deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# 邀请码（自己和朋友登录用）
INVITE_CODE=mianshi2026

# 服务端口
PORT=8600

# 飞书凭证（选填：配置后「资料同步」会自动拉取最新文档）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPACE_ID=
